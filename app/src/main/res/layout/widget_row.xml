<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp">
    <ImageView android:id="@+id/widget_check" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:src="@drawable/ic_circle" android:contentDescription="标记完成"/>
    <LinearLayout android:id="@+id/widget_content" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/widget_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textSize="14sp"/>
        <TextView android:id="@+id/widget_row_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
