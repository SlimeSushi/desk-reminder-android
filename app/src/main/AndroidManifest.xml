        <activity android:name=".widget.WidgetQuickAddActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="${applicationId}.widgetquickadd" android:theme="@style/Theme.DeskReminder.WidgetQuickAdd" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".widget.WidgetActionActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="${applicationId}.widgetactions" android:theme="@style/Theme.DeskReminder.WidgetQuickAdd"/>
        <service android:name=".widget.WidgetCollectionService" android:exported="false" android:permission="android.permission.BIND_REMOTEVIEWS"/>
        <service android:name=".data.cloud.NutstoreSyncJobService" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE"/>
        <receiver android:name=".reminder.ReminderReceiver" android:exported="false" />
